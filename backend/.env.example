# 서버
PORT=8080
NODE_ENV=production
# 프론트엔드 도메인 (CORS 허용). 여러 개는 콤마로 구분
CORS_ORIGIN=https://your-frontend-domain.com

# 관리자 인증 (모더레이션 대시보드 접근용) - 반드시 강력한 랜덤 값으로 교체하세요
ADMIN_API_KEY=change-me-to-a-long-random-string

# 데이터베이스 (Render의 무료 PostgreSQL 등에서 발급받은 "External Database URL")
DATABASE_URL=postgres://user:password@host:5432/dbname

# 파일 저장 방식: local | s3
# Render 무료 웹서비스는 디스크가 영구 저장되지 않으니 반드시 s3(Cloudflare R2 등)를 쓰세요.
STORAGE_DRIVER=s3

# STORAGE_DRIVER=local 일 때만 사용 (로컬 테스트용)
LOCAL_UPLOAD_DIR=./uploads
PUBLIC_BASE_URL=http://localhost:8080

# STORAGE_DRIVER=s3 일 때 (Cloudflare R2 - S3 호환 스토리지)
S3_BUCKET=looklike-images
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
# R2 버킷의 Public Access를 켜면 나오는 주소 (r2.dev 서브도메인 또는 커스텀 도메인)
S3_PUBLIC_URL_BASE=https://pub-xxxxxxxx.r2.dev

# 신고 누적 시 자동 비공개 처리 기준
AUTO_HIDE_REPORT_THRESHOLD=3

# 이미지 부적절 콘텐츠 검열 (Sightengine - https://sightengine.com)
# 비워두면 이미지 검열 없이 업로드가 허용되니, 실서비스 전 반드시 설정하세요.
SIGHTENGINE_API_USER=
SIGHTENGINE_API_SECRET=

# 업로드 제한 (MB)
MAX_IMAGE_SIZE_MB=20
